# WarmHawk Core Engine — environment template. `scripts/install.sh` generates every secret below
# via `openssl rand` and writes a real `.env/.env` — a customer never types or manages one of these
# by hand. Copy to `.env/.env` only for manual/local development; never commit a real `.env/.env`.
# No .env.stage/.env.prod exist for this repo by design — it ships as a self-hosted package with no
# vendor-operated deploy target of its own (every install generates its own `.env/.env`, on whatever
# box it runs on); see docs/ for the full rationale.

# --- Domain / TLS ---
WARMHAWK_DOMAIN=api.yourcompany.com

# --- Host ports (docker/docker-compose.yml) --------------------------------
# nginx's host-side HTTP/HTTPS port mapping. Defaults below match
# docker-compose.yml; install.sh falls back to alternates automatically if
# 80/443 are already taken on the host (see its --skip-certbot/port-fallback
# logic) and records whatever it actually used here.
NGINX_HTTP_HOST_PORT=80
NGINX_HTTPS_HOST_PORT=443

# How many reverse proxies sit in front of the API. Leave unset unless you put something of your
# own ahead of the bundled nginx: the default of 1 already accounts for that nginx, which is the
# only thing that can reach the api container. Add one per extra layer — a CDN, a load balancer,
# another nginx — and the API reads the real client address rather than a proxy's.
#
# Getting it wrong is worth understanding. Too LOW and every caller behind the untrusted layer
# shares one rate-limit bucket, so one busy client throttles everyone. Too HIGH and callers can
# forge an address to mint themselves a fresh bucket per request, evading the limits entirely.
# Count the hops; don't guess upward "to be safe".
TRUST_PROXY_HOPS=1

# --- Secrets (install.sh: `openssl rand -base64 32|48`) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MAILBOX_CREDENTIAL_KEY=
NEXTJS_CALLBACK_SECRET= # gitleaks:allow — empty placeholder, install.sh generates the real value
N8N_ENCRYPTION_KEY=
# Auth bridge the licensed dashboard uses to authenticate against this engine's API (see
# lib/requireAuth.ts's header comment) — a single long-lived shared secret, same pattern as
# NEXTJS_CALLBACK_SECRET above. Leave blank if this engine is only ever used Tier-0-style (direct
# API, no dashboard); every `/v1/*` route stays reachable via the normal JWT login either way. If
# you DO run the dashboard, this value must be copied verbatim into that product's own .env as
# CORE_ENGINE_SERVICE_TOKEN — the two packages never share a Docker network or a `.env` file, so
# nothing generates this for you automatically on that side.
OPERATOR_SERVICE_TOKEN=

# --- Uptime Kuma (bundled monitoring container, default-on per tier-config's `uptimeKumaBundled`)
#     Auto-provisioned by the `kuma-provision` Compose job (scripts/install.sh runs it right after
#     the container comes up) — admin login, plus one monitor per internal service, 60s interval.
#     UPTIME_KUMA_PASSWORD is generated like every other secret above if left unset.
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=
# Optional — a webhook URL (Slack/Discord/PagerDuty/generic) to receive down/up alerts. Leave
# blank for dashboard-only monitoring with no external alerting.
UPTIME_KUMA_ALERT_WEBHOOK_URL=

# --- Tier 2 alerting (domain DNS-check change notifications) ---
# Set manually by the founder during a Tier 2 white-glove install — there is no automated
# tier-branching logic anywhere in this repo; an unset TIER2_ALERT_WEBHOOK_URL is itself the
# "off" switch (see lib/alertWebhook.ts). Leave both blank for a normal (non-Tier-2) install.
TIER2_ALERT_WEBHOOK_URL=
TIER2_ALERT_WEBHOOK_FORMAT=generic   # generic | slack

# --- Dashboard (the licensed dashboard product), if co-located ---
DASHBOARD_APP_URL=https://app.yourcompany.com

# --- Google Workspace OAuth (mailbox connect —
#     needs its own WarmHawk-branded app registration, see Mailbox Connection Upgrade) ---
# A paid (Tier 1/2) install should configure this from the dashboard's Settings → Mailbox OAuth
# Apps page instead of here — nothing below is required there, and the dashboard also shows the
# exact redirect URI to register with Google, computed from WARMHAWK_DOMAIN. These vars remain a
# valid alternative for a Tier 0 (dashboard-less) self-hosted install, or as an ops-level override
# on any tier.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional — leave blank to use https://${WARMHAWK_DOMAIN}/v1/oauth/google/callback (must include
# the /v1 prefix if set explicitly; nginx.conf.template only proxies /v1/oauth/, not a bare
# /oauth/, so a mismatched value gets a hard redirect_uri_mismatch from Google with no way back
# into WarmHawk — the computed default avoids ever hand-typing this).
GOOGLE_OAUTH_REDIRECT_URI=

# --- Microsoft 365 OAuth (mailbox connect — new; requires an Entra app registration, external,
#     not a Go-Live blocker — SMTP/IMAP password remains the fallback) ---
# Same dashboard-first guidance as the Google block above.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional — leave blank to use https://${WARMHAWK_DOMAIN}/v1/oauth/microsoft/callback.
MICROSOFT_OAUTH_REDIRECT_URI=

# --- Stripe / license issuance: NOT this repo's concern (V12 fix). Tier 0 (this engine) carries
#     no license gate at all. That logic lives solely in WarmHawk's billing/marketing site (Stripe
#     webhook + RSA signing) and the licensed dashboard product (RSA verification only) — see
#     those products' own .env.example for STRIPE_*/LICENSE_SIGNING_PRIVATE_KEY/LICENSE_PUBLIC_KEY_PEM.

# --- Observability (Observability section — inert until set) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Backups (scripts/backup-postgres.sh) ---
BACKUP_LOCAL_PATH=/var/backups/warmhawk
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=

# --- Shared edge proxy (only on a host that runs one, e.g. a multi-tenant staging box) ---
# Leave both blank for a normal customer install — docker-compose.yml's own defaults
# (warmhawk-edge / warmhawk-core-engine-nginx) apply and nothing pre-existing is required.
# Set EDGE_NETWORK_NAME to a value unique on the host when another install (this repo or
# the licensed dashboard product) shares it, so their edge networks don't collide.
EDGE_NETWORK_NAME=
EDGE_NGINX_ALIAS=
