      "position": [-800, 0],
      "webhookId": "warmhawk-dispatch",
      "parameters": {
        "httpMethod": "POST",
        "path": "warmhawk/dispatch",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "d2-personalize",
      "name": "Call internal/ai/personalize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-560, 0],
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_INTERNAL_BASE_URL}}/internal/ai/personalize",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Callback-Secret", "value": "={{$env.NEXTJS_CALLBACK_SECRET}}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"campaignId\": $json.body.campaignId, \"leadId\": $json.body.leadId, \"mailboxId\": $json.body.mailboxId } }}",
        "options": {}
      }
    },
    {
      "id": "d3-build-payload",
      "name": "Build Email Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 0],
      "parameters": {
        "jsCode": "// /internal/ai/personalize (apps/api/src/routes/internalAi.ts) returns the finished subject and\n// body — the campaign's own subject, or the one the AI wrote, already resolved server-side (see\n// apps/api/src/lib/composeCampaignEmail.ts). The first-newline split below is only for a core\n// engine from before it returned them separately: the first line becomes the subject (falls back\n// to a generic opener if there's no natural first-line break), the remainder is the body.\nconst trigger = $('Webhook: warmhawk/dispatch').first().json.body;\nconst personalized = $input.first().json;\n\nlet subject = typeof personalized.subject === 'string' ? personalized.subject.trim() : '';\nlet body = typeof personalized.body === 'string' ? personalized.body.trim() : '';\nif (!subject || !body) {\n  const generatedText = personalized.generatedText || '';\n  const firstNewline = generatedText.indexOf('\\n');\n  if (firstNewline > 0 && firstNewline < 120) {\n    subject = generatedText.slice(0, firstNewline).trim();\n    body = generatedText.slice(firstNewline + 1).trim();\n  } else {\n    subject = 'Quick question';\n    body = generatedText.trim();\n  }\n  if (!subject) subject = 'Quick question';\n  if (!body) body = generatedText.trim() || subject;\n}\n\nreturn [{\n  json: {\n    leadId: trigger.leadId,\n    mailboxId: trigger.mailboxId,\n    campaignId: trigger.campaignId,\n    email: trigger.email,\n    subject,\n    body,\n    aiUsed: personalized.aiUsed === true,\n    aiOutcome: personalized.aiOutcome || null,\n    aiFallbackReason: personalized.aiFallbackReason || null\n  }\n}];"
      }
    },
    {
      "id": "d4-send",
      "name": "Call internal/mail/send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_INTERNAL_BASE_URL}}/internal/mail/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Callback-Secret", "value": "={{$env.NEXTJS_CALLBACK_SECRET}}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"mailboxId\": $json.mailboxId, \"to\": $json.email, \"subject\": $json.subject, \"body\": $json.body, \"campaignId\": $json.campaignId, \"leadId\": $json.leadId, \"n8nExecutionId\": $execution.id, \"aiOutcome\": $json.aiOutcome, \"aiFallbackReason\": $json.aiFallbackReason } }}",
        "options": {}
      }
    },
    {
      "id": "d5-respond-sent",
      "name": "Respond Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [160, -140],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ { \"status\": \"sent\", \"leadId\": $('Build Email Payload').item.json.leadId, \"messageId\": $json.messageId } }}"
      }
    },
    {
      "id": "d6-respond-failed",
      "name": "Respond Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [160, 140],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ { \"status\": \"failed\", \"leadId\": $('Build Email Payload').item.json.leadId, \"error\": $json.error || 'send failed' } }}"
      }
    }
  ],
  "connections": {
    "Webhook: warmhawk/dispatch": { "main": [[{ "node": "Call internal/ai/personalize", "type": "main", "index": 0 }]] },
    "Call internal/ai/personalize": { "main": [[{ "node": "Build Email Payload", "type": "main", "index": 0 }]] },
    "Build Email Payload": { "main": [[{ "node": "Call internal/mail/send", "type": "main", "index": 0 }]] },
    "Call internal/mail/send": {
      "main": [
        [{ "node": "Respond Sent", "type": "main", "index": 0 }],
        [{ "node": "Respond Failed", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
