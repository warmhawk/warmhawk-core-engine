# WarmHawk API — non-root Docker pattern ported from outreach-infra's Dockerfiles, digest-pinned
# base image (verified real digest via `docker buildx imagetools inspect node:20-alpine` at
# build-time of this repo — re-verify and re-pin before each release, digests rotate as the
# upstream image is rebuilt).
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build
WORKDIR /repo
# Must match the runtime stage's `apk add openssl` below — `prisma generate` fingerprints the
# OpenSSL present at generate-time to pick which query-engine binary to fetch (e.g.
# linux-musl-openssl-3.0.x). Skipping this here made it fetch the plain "linux-musl" engine
# instead, which then failed to load at runtime once the runtime stage's openssl (3.x) was
# actually present — found running this image for the first time locally.
RUN apk update && apk upgrade --no-cache && apk add --no-cache openssl
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/tier-config/package.json packages/tier-config/package.json
COPY packages/ops-scripts/package.json packages/ops-scripts/package.json
RUN npm install --workspaces --include-workspace-root
COPY . .
RUN npm run db:generate
# devDependencies (vitest, typescript, eslint, etc.) have no business in the runtime image;
# `db:generate` above already ran with the `prisma` devDependency present, so this can safely run
# after it. (The actual Trivy container-security gate failure traced to npm's own bundled
# node_modules baked into the base image, not this repo's tree — see the runtime stage's `rm -rf`
# below — but this prune is still worth keeping for a smaller, lower-surface runtime image.)
RUN npm prune --omit=dev --workspaces --include-workspace-root

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS runtime
ENV NODE_ENV=production
RUN apk update && apk upgrade --no-cache && apk add --no-cache openssl && addgroup -S app && adduser -S app -G app
# node:20-alpine bundles npm's own internal dependency snapshot (its vendored tar/glob/minimatch/
# brace-expansion/cross-spawn/sigstore/ip-address, used by npm's own registry/install machinery) —
# unrelated to anything in this repo's package-lock.json, but still scanned and flagged by the
# container-security Trivy gate since it's on disk in every node:20-alpine image regardless of
# npm version. Nothing at runtime needs `npm`/`npx`/`corepack` (see CMD below, which invokes tsx
# directly), so the fix is to delete them rather than chase npm CLI version bumps that don't
# reliably clear this — found by tracing every flagged package.json's actual path in the built
# image back to /usr/local/lib/node_modules/npm/node_modules/*, not this repo's own node_modules.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /repo

# --chown so the non-root `app` user can write into node_modules/@prisma — Prisma's
# engine-resolution step needs write access there even at runtime.
COPY --from=build --chown=app:app /repo/node_modules ./node_modules
COPY --from=build --chown=app:app /repo/package.json ./package.json
COPY --from=build --chown=app:app /repo/packages ./packages
COPY --from=build --chown=app:app /repo/apps/api ./apps/api
COPY --from=build --chown=app:app /repo/constants.ts ./constants.ts

USER app
WORKDIR /repo/apps/api
EXPOSE 4600
CMD ["node", "/repo/node_modules/.bin/tsx", "src/index.ts"]
