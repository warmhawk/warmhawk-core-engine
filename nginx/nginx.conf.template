# WarmHawk Core Engine — bundled nginx config template. Rendered by the official nginx image's
# built-in envsubst-on-templates mechanism (/etc/nginx/templates/*.template ->
# /etc/nginx/conf.d/*.conf at container start). This is the ONLY container in this package
# publishing a host port — every upstream here is reached over the internal-only
# `warmhawk_internal` Docker network, never a host-bound port.
#
# TLS bootstrap: scripts/install.sh brings this up HTTP-only first (the `listen 443` block is a
# no-op until a real cert exists), runs `certbot certonly --webroot` against the webroot path
# below, then reloads nginx once the cert is issued. Renewal is a separate `certbot renew` loop
# container (docker-compose.yml's `certbot` service) on its own sleep-based schedule.

server {
    listen 80;
    server_name ${WARMHAWK_DOMAIN};

    # ACME HTTP-01 challenge webroot — must stay reachable over plain HTTP even after TLS is live,
    # since certbot's renewal loop re-validates this same path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else redirects to HTTPS once a certificate exists. Before that (fresh install,
    # before the first certbot run), scripts/install.sh proxies API traffic here directly in
    # HTTP-only mode so the instance is still reachable during the brief TLS-bootstrap window.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${WARMHAWK_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WARMHAWK_DOMAIN}/fullchain.pem;
    ssl_certificate_key  /etc/letsencrypt/live/${WARMHAWK_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Public API surface only, all under /v1/ (API-surface correction pass — every route in
    # apps/api/src/app.ts's `/v1` group gets a location block here; `/leads/` covers both
    # `/v1/leads/...` and `/v1/leads/webhook` since it's one Fastify plugin tree under one prefix).
    # `/internal/*` has NO location block here and is therefore unreachable from outside the
    # internal Docker network, by omission, not by an access-control rule that could be
    # misconfigured.
    location /health {
        proxy_pass http://api:4600;
    }

    location /v1/leads/ {
        proxy_pass http://api:4600;
    }

    location /v1/campaigns/ {
        proxy_pass http://api:4600;
    }

    location /v1/mailboxes/ {
        proxy_pass http://api:4600;
    }

    location /v1/domains/ {
        proxy_pass http://api:4600;
    }

    location /v1/queue/ {
        proxy_pass http://api:4600;
    }

    location /v1/seed-accounts/ {
        proxy_pass http://api:4600;
    }

    location /v1/ai-providers/ {
        proxy_pass http://api:4600;
    }

    location /v1/replies/ {
        proxy_pass http://api:4600;
    }

    location /v1/oauth/ {
        proxy_pass http://api:4600;
    }

    location /v1/public/ {
        proxy_pass http://api:4600;
    }

    location /v1/auth/ {
        proxy_pass http://api:4600;
    }

    location /v1/instance-settings/ {
        proxy_pass http://api:4600;
    }

    # Bundled Uptime Kuma dashboard, served under its own path so a customer can reach it through
    # the same TLS-terminated domain without a second cert/subdomain.
    location /status/ {
        proxy_pass http://uptime-kuma:3001/;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
